# (data/processed/eval_semeval.json) are kept.
data/semeval/
data/processed/semeval_predictions.jsonl

# Kept on purpose: data/processed (pipeline results the app reads), data/labels (my hand
# labels), data/cache/llm_cache.jsonl (call cache: makes the demo examples instant and free),
# data/chroma (the search index, so the deployed app does not rebuild it on every start)
